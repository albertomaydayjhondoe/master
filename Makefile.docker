# 🎵 Neural Forge Discográfica - Docker Management Makefile
# =========================================================

.PHONY: help build dev prod stop clean logs shell health backup restore

# Default target
.DEFAULT_GOAL := help

# Colors for output
RED := \033[0;31m
GREEN := \033[0;32m
YELLOW := \033[1;33m
BLUE := \033[0;34m
PURPLE := \033[0;35m
CYAN := \033[0;36m
NC := \033[0m # No Color

help: ## 📋 Show this help message
	@echo "$(CYAN)🎵 Neural Forge Discográfica - Docker Commands$(NC)"
	@echo "$(CYAN)===============================================$(NC)"
	@echo ""
	@echo "$(YELLOW)📦 DEVELOPMENT:$(NC)"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | grep "🛠️\|📦\|🔧" | awk 'BEGIN {FS = ":.*?## "}; {printf "  $(GREEN)%-20s$(NC) %s\n", $$1, $$2}'
	@echo ""
	@echo "$(YELLOW)🚀 PRODUCTION:$(NC)"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | grep "🚀\|🏭\|📊" | awk 'BEGIN {FS = ":.*?## "}; {printf "  $(GREEN)%-20s$(NC) %s\n", $$1, $$2}'
	@echo ""
	@echo "$(YELLOW)🔧 MANAGEMENT:$(NC)"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | grep "🔧\|🗄️\|📋\|🧹" | awk 'BEGIN {FS = ":.*?## "}; {printf "  $(GREEN)%-20s$(NC) %s\n", $$1, $$2}'
	@echo ""

# 📦 Development Commands
build: ## 🛠️ Build all Docker images
	@echo "$(BLUE)🔨 Building all Docker images...$(NC)"
	docker compose build --parallel

dev: ## 📦 Start development environment
	@echo "$(GREEN)🛠️ Starting development environment...$(NC)"
	@cp .env.production.template .env
	docker compose -f docker-compose.dev.yml up -d
	@echo "$(GREEN)✅ Development environment started!$(NC)"
	@echo "$(YELLOW)📊 Dashboards:$(NC)"
	@echo "  🎮 Production Controller: http://localhost:7860"
	@echo "  📈 Analytics Engine: http://localhost:8501"
	@echo "  🧠 ML Core API: http://localhost:8000/docs"
	@echo "  🔄 N8N Workflows: http://localhost:5678"

dev-logs: ## 🔧 Show development logs
	docker compose -f docker-compose.dev.yml logs -f

dev-stop: ## 🔧 Stop development environment
	@echo "$(YELLOW)🛑 Stopping development environment...$(NC)"
	docker compose -f docker-compose.dev.yml down

# 🚀 Production Commands
prod: ## 🚀 Start production environment
	@echo "$(GREEN)🚀 Starting production environment...$(NC)"
	@if [ ! -f .env.production ]; then \
		echo "$(RED)❌ .env.production file not found!$(NC)"; \
		echo "$(YELLOW)📋 Copy .env.production.template to .env.production and configure it$(NC)"; \
		exit 1; \
	fi
	docker compose -f docker-compose.prod.yml up -d
	@echo "$(GREEN)✅ Production environment started!$(NC)"
	@echo "$(YELLOW)📊 Services available at:$(NC)"
	@echo "  🌐 Main Dashboard: https://your-domain.com"
	@echo "  📈 Monitoring: https://your-domain.com/grafana"

prod-build: ## 🏭 Build production images with optimizations
	@echo "$(BLUE)🏭 Building production images...$(NC)"
	docker compose -f docker-compose.prod.yml build --parallel --no-cache

prod-logs: ## 📊 Show production logs
	docker compose -f docker-compose.prod.yml logs -f

prod-stop: ## 🔧 Stop production environment
	@echo "$(YELLOW)🛑 Stopping production environment...$(NC)"
	docker compose -f docker-compose.prod.yml down

# 🔧 Management Commands
stop: ## 🔧 Stop all containers
	@echo "$(YELLOW)🛑 Stopping all containers...$(NC)"
	docker compose down
	docker compose -f docker-compose.dev.yml down
	docker compose -f docker-compose.prod.yml down

clean: ## 🧹 Clean unused Docker resources
	@echo "$(YELLOW)🧹 Cleaning Docker resources...$(NC)"
	docker system prune -f
	docker volume prune -f
	docker network prune -f

clean-all: ## 🧹 Clean all Docker resources (including images)
	@echo "$(RED)🧹 WARNING: This will remove all Docker resources!$(NC)"
	@echo "$(YELLOW)Press Ctrl+C to cancel, or wait 5 seconds...$(NC)"
	@sleep 5
	docker system prune -af --volumes
	docker image prune -af

logs: ## 📋 Show logs for all services
	docker compose logs -f

health: ## 🔧 Check health of all services
	@echo "$(BLUE)🏥 Checking service health...$(NC)"
	@docker compose ps
	@echo ""
	@echo "$(BLUE)🔍 Service URLs:$(NC)"
	@echo "  🎮 Production Controller: $(shell curl -s -o /dev/null -w "%%{http_code}" http://localhost:7860/health 2>/dev/null || echo "❌")"
	@echo "  📈 Analytics Engine: $(shell curl -s -o /dev/null -w "%%{http_code}" http://localhost:8501/health 2>/dev/null || echo "❌")"
	@echo "  🧠 ML Core API: $(shell curl -s -o /dev/null -w "%%{http_code}" http://localhost:8000/health 2>/dev/null || echo "❌")"
	@echo "  🔄 N8N: $(shell curl -s -o /dev/null -w "%%{http_code}" http://localhost:5678/healthz 2>/dev/null || echo "❌")"

shell: ## 🔧 Open shell in production controller container
	docker compose exec production-controller /bin/bash

shell-ml: ## 🔧 Open shell in ML core container
	docker compose exec ml-core /bin/bash

shell-db: ## 🔧 Open PostgreSQL shell
	docker compose exec postgres psql -U neural_forge -d neural_forge

# 🗄️ Database Commands
db-backup: ## 🗄️ Backup database
	@echo "$(BLUE)💾 Creating database backup...$(NC)"
	@mkdir -p backups
	docker compose exec postgres pg_dump -U neural_forge neural_forge > backups/backup_$(shell date +%Y%m%d_%H%M%S).sql
	@echo "$(GREEN)✅ Database backup created in backups/$(NC)"

db-restore: ## 🗄️ Restore database from backup (Usage: make db-restore BACKUP=backup_file.sql)
	@if [ -z "$(BACKUP)" ]; then \
		echo "$(RED)❌ Please specify BACKUP file: make db-restore BACKUP=backup_file.sql$(NC)"; \
		exit 1; \
	fi
	@echo "$(YELLOW)⚠️ This will overwrite the current database!$(NC)"
	@echo "$(YELLOW)Press Ctrl+C to cancel, or wait 5 seconds...$(NC)"
	@sleep 5
	docker compose exec -T postgres psql -U neural_forge -d neural_forge < $(BACKUP)
	@echo "$(GREEN)✅ Database restored from $(BACKUP)$(NC)"

# 📊 Monitoring Commands
stats: ## 📊 Show Docker stats
	docker stats

top: ## 📊 Show running processes in containers
	docker compose top

# 🔄 Update Commands
update: ## 🔄 Update all services (pull latest images)
	@echo "$(BLUE)🔄 Updating services...$(NC)"
	docker compose pull
	docker compose -f docker-compose.prod.yml pull
	@echo "$(GREEN)✅ Services updated!$(NC)"

restart: ## 🔄 Restart all services
	@echo "$(YELLOW)🔄 Restarting all services...$(NC)"
	docker compose restart
	@echo "$(GREEN)✅ Services restarted!$(NC)"

# 🧪 Testing Commands
test: ## 🧪 Run system tests
	@echo "$(BLUE)🧪 Running system tests...$(NC)"
	docker compose exec production-controller python -c "
import requests
import sys

tests = [
    ('Production Controller', 'http://localhost:7860/health'),
    ('Analytics Engine', 'http://localhost:8501/health'),
    ('ML Core API', 'http://localhost:8000/health'),
]

for name, url in tests:
    try:
        response = requests.get(url, timeout=5)
        status = '✅' if response.status_code == 200 else '❌'
        print(f'{status} {name}: {response.status_code}')
    except Exception as e:
        print(f'❌ {name}: {str(e)}')
"

# 🚨 Emergency Commands
emergency-stop: ## 🚨 Emergency stop (kill all containers)
	@echo "$(RED)🚨 EMERGENCY STOP - Killing all containers!$(NC)"
	docker kill $(shell docker ps -q) 2>/dev/null || true

emergency-restart: ## 🚨 Emergency restart
	@echo "$(RED)🚨 EMERGENCY RESTART$(NC)"
	make emergency-stop
	sleep 2
	make dev

# 📈 Performance Commands
optimize: ## 📈 Optimize Docker performance
	@echo "$(BLUE)📈 Optimizing Docker performance...$(NC)"
	docker system prune -f
	docker volume prune -f
	@echo "$(GREEN)✅ Docker optimized!$(NC)"

# 🔐 Security Commands
security-scan: ## 🔐 Scan images for vulnerabilities
	@echo "$(BLUE)🔐 Scanning images for vulnerabilities...$(NC)"
	@docker images --format "table {{.Repository}}:{{.Tag}}" | grep neural-forge | while read image; do \
		echo "Scanning $$image..."; \
		docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:latest image $$image; \
	done

# 💾 Full System Backup
full-backup: ## 💾 Create full system backup
	@echo "$(BLUE)💾 Creating full system backup...$(NC)"
	@mkdir -p backups/full_$(shell date +%Y%m%d_%H%M%S)
	make db-backup
	docker run --rm -v neural-forge_prod_data:/data -v $(PWD)/backups:/backup alpine tar czf /backup/full_$(shell date +%Y%m%d_%H%M%S)/data_volumes.tar.gz -C /data .
	@echo "$(GREEN)✅ Full system backup completed!$(NC)"

# 🎯 Quick Start Commands
quickstart: ## 🎯 Quick start for new users
	@echo "$(CYAN)🎯 Neural Forge Quick Start$(NC)"
	@echo "$(CYAN)===========================$(NC)"
	@echo ""
	@echo "$(YELLOW)1.$(NC) Building images..."
	make build
	@echo ""
	@echo "$(YELLOW)2.$(NC) Starting development environment..."
	make dev
	@echo ""
	@echo "$(GREEN)🎉 Neural Forge is ready!$(NC)"
	@echo ""
	@echo "$(YELLOW)📊 Access your dashboards:$(NC)"
	@echo "  🎮 Production Controller: http://localhost:7860"
	@echo "  📈 Analytics Engine: http://localhost:8501"
	@echo "  🧠 ML Core API: http://localhost:8000/docs"
	@echo "  🔄 N8N Workflows: http://localhost:5678"
	@echo ""
	@echo "$(BLUE)💡 Next steps:$(NC)"
	@echo "  1. Configure your API keys in the Production Controller"
	@echo "  2. Create your first viral campaign"
	@echo "  3. Monitor results in Analytics Engine"

# 📚 Documentation
docs: ## 📚 Generate documentation
	@echo "$(BLUE)📚 Opening documentation...$(NC)"
	@echo "$(YELLOW)📋 Available documentation:$(NC)"
	@echo "  📖 PROMPT_RECTOR_REFINADO.md - Complete system overview"
	@echo "  🐳 Docker Compose files for all environments"
	@echo "  🔧 This Makefile with all commands"
	@echo ""
	@echo "$(BLUE)🌐 Online docs will be available at:$(NC)"
	@echo "  📊 ML Core API: http://localhost:8000/docs"
	@echo "  📊 ML Core Redoc: http://localhost:8000/redoc"