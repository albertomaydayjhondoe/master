# 🎵 Neural Forge Trap Artist - Production Dockerfile
FROM python:3.11-slim

# Metadata
LABEL maintainer="Neural Forge Team"
LABEL description="Trap Artist Viral Campaign System"
LABEL version="2.0"

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive

# Create app user
RUN groupadd -r trapforge && useradd -r -g trapforge trapforge

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    ffmpeg \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Set work directory
WORKDIR /app

# Copy requirements first (for better caching)
COPY requirements.txt requirements-extensions.txt ./

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r requirements-extensions.txt && \
    pip install --no-cache-dir \
        python-dotenv \
        psycopg2-binary \
        redis \
        celery \
        gunicorn \
        uvicorn[standard]

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p /app/data/generated_videos \
             /app/data/temp \
             /app/logs \
             /app/config/campaigns && \
    chown -R trapforge:trapforge /app

# Switch to non-root user
USER trapforge

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start command
CMD ["uvicorn", "trap_artist_api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]