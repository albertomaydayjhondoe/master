# 🛰️ Neural Forge - Meta Ads Automation Dockerfile
FROM python:3.11-slim

LABEL maintainer="Neural Forge Discográfica <info@neuralforge.com>"
LABEL description="Meta Ads Automation - Facebook/Instagram Campaign Management"
LABEL version="3.0"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for better layer caching
COPY requirements.txt .
COPY requirements-dummy.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r requirements-dummy.txt

# Install Meta-specific dependencies
RUN pip install --no-cache-dir \
    facebook-business \
    instagram-basic-display \
    selenium \
    webdriver-manager

# Create necessary directories
RUN mkdir -p /app/data /app/config /app/logs

# Copy application files
COPY meta_automation/ ./meta_automation/
COPY config/ ./config/
COPY database/ ./database/

# Copy startup script
COPY docker/scripts/start-meta-ads.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/start-meta-ads.sh

# Create non-root user for security
RUN useradd -m -u 1001 neuralforge && \
    chown -R neuralforge:neuralforge /app
USER neuralforge

# Expose port
EXPOSE 8002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8002/health || exit 1

# Start application
CMD ["/usr/local/bin/start-meta-ads.sh"]