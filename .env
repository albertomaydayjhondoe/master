# Universal Project Environment Variables
PROJECT_ROOT=/workspaces/master
DUMMY_MODE=true
SIMULATION_LEVEL=full
AUTO_WAKE_SERVICES=true
GENERATE_TEST_DATA=true

# Global Database Configuration
GLOBAL_DB_HOST=localhost
GLOBAL_DB_PORT=5432
GLOBAL_DB_USER=dummy_user
GLOBAL_DB_PASSWORD=dummy_password
# Cloud Simulation Endpoints
CLOUD_POSTGRESQL_URL=postgresql://dummy:dummy@localhost:5432
CLOUD_MONGODB_URL=mongodb://dummy:dummy@localhost:27017
CLOUD_REDIS_URL=redis://localhost:6379
CLOUD_ELASTICSEARCH_URL=http://localhost:9200
# Monitoring and Logging
LOG_LEVEL=INFO
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=300
ALERT_WEBHOOK_URL=http://localhost:3000/alerts
# Development Settings
DEBUG_MODE=true
HOT_RELOAD=true
API_DOCS_ENABLED=true
CORS_ENABLED=true