# 🎵 CONFIGURACIÓN PARA DISCOGRÁFICA ML SYSTEM

## 🚀 VARIABLES DE ENTORNO PARA PRODUCCIÓN

# ===================================
# CONFIGURACIÓN GENERAL DEL SISTEMA
# ===================================
PROJECT_NAME=discografica-ml-system
SYSTEM_MODE=production
DUMMY_MODE=false

# ===================================
# CONFIGURACIÓN DE PUERTOS
# ===================================
PRODUCTION_CONTROLLER_PORT=7860
ANALYTICS_ENGINE_PORT=8501
ML_API_PORT=8000
N8N_PORT=5678

# ===================================
# META ADS / FACEBOOK MARKETING API
# ===================================
META_ACCESS_TOKEN=your_meta_access_token_here
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_AD_ACCOUNT_ID=act_your_ad_account_id_here
META_PAGE_ID=your_facebook_page_id_here

# ===================================
# YOUTUBE DATA API V3
# ===================================
YOUTUBE_CLIENT_ID=your_youtube_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here

# ===================================
# TELEGRAM BOT API
# ===================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/webhook

# ===================================
# GOLOGIN API (OPCIONAL)
# ===================================
GOLOGIN_API_TOKEN=your_gologin_api_token_here
GOLOGIN_PROFILE_COUNT=10

# ===================================
# BASE DE DATOS
# ===================================
DATABASE_URL=sqlite:///discografica_ml.db
# Para PostgreSQL: postgresql://user:password@localhost/discografica_ml
REDIS_URL=redis://localhost:6379

# ===================================
# MACHINE LEARNING CONFIGURATION
# ===================================
ML_MODEL_PATH=data/models/production/
YOLO_MODEL_PATH=data/models/yolo/best.pt
ML_CONFIDENCE_THRESHOLD=0.7
ULTRALYTICS_SETTINGS_PATH=config/ml/ultralytics_settings.yaml

# ===================================
# N8N WORKFLOW ORCHESTRATION
# ===================================
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=discografica_admin
N8N_BASIC_AUTH_PASSWORD=your_n8n_password_here
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# ===================================
# PROXY CONFIGURATION (OPCIONAL)
# ===================================
HTTP_PROXY=
HTTPS_PROXY=
USE_PROXY=false

# ===================================
# LOGGING Y MONITORING
# ===================================
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/discografica_ml.log
ENABLE_METRICS=true
GRAFANA_URL=http://localhost:3000

# ===================================
# CONFIGURACIÓN DE CAMPAÑAS
# ===================================
DEFAULT_CAMPAIGN_BUDGET=100
MAX_DAILY_POSTS=50
ENGAGEMENT_RATE_TARGET=0.05
VIRAL_THRESHOLD_VIEWS=10000

# ===================================
# SECURITY
# ===================================
SECRET_KEY=your_secret_key_for_encryption_here
JWT_SECRET=your_jwt_secret_key_here
API_RATE_LIMIT=1000

# ===================================
# DISCORD INTEGRATION (OPCIONAL)
# ===================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_server_id_here

# ===================================
# SPOTIFY API (FUTURO)
# ===================================
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ===================================
# CONFIGURACIÓN DE ARTISTAS
# ===================================
ARTIST_NAME=Tu Nombre Artístico
ARTIST_GENRE=trap,reggaeton,urban
ARTIST_INSTAGRAM=@tu_instagram
ARTIST_TIKTOK=@tu_tiktok
ARTIST_YOUTUBE=@tu_youtube

# ===================================
# CONFIGURACIÓN AVANZADA
# ===================================
ENABLE_AUTO_POSTING=true
ENABLE_AUTO_ENGAGEMENT=true
ENABLE_ML_PREDICTIONS=true
ENABLE_VIRAL_DETECTION=true
BACKUP_FREQUENCY=daily